+func TestSprintPerformanceOutcomeExitCompatibility(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		outcome sprint.PerformanceRunOutcome
+		exit    int
+	}{
+		{name: "success", outcome: sprint.PerformancePassed},
+		{name: "success with reports", outcome: sprint.PerformancePassedWithReports},
+		{name: "target missed", outcome: sprint.PerformanceTargetMiss, exit: ExitValidation},
+		{name: "cancelled", outcome: sprint.PerformanceCancelled, exit: ExitCancel},
+		{name: "partial blocked", outcome: sprint.PerformanceBlocked, exit: ExitPartial},
+		{name: "partial stalled", outcome: sprint.PerformanceStalled, exit: ExitPartial},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			err := performanceSemanticOutcomeError(sprint.PerformanceResult{Outcome: test.outcome})
+			if test.exit == ExitOK {
+				if err != nil {
+					t.Fatalf("successful outcome returned %v", err)
+				}
+			} else {
+				var classed classedError
+				if !errors.As(err, &classed) || classed.class != test.exit {
+					t.Fatalf("outcome %q mapped to %v, want exit %d", test.outcome, err, test.exit)
+				}
+			}
+
+			for _, jsonOut := range []bool{false, true} {
+				var stdout, stderr bytes.Buffer
+				status := PerformanceStatusResult{SchemaVersion: 1, Project: "proj", Sprint: "01-alpha", PolicyMode: "enabled", Enabled: true, Phase: "terminal", Fresh: true, Outcome: string(test.outcome), NextAction: "inspect"}
+				err := finishSprintPerformanceOutcome(dependencies{stdout: &stdout, stderr: &stderr}, sprintPerformanceCommand{Action: "run", JSON: jsonOut}, status, sprint.PerformanceResult{Outcome: test.outcome})
+				if stderr.String() != "" {
+					t.Fatalf("json=%t wrote stderr %q", jsonOut, stderr.String())
+				}
+				if test.exit == ExitOK {
+					if err != nil {
+						t.Fatalf("json=%t successful outcome returned %v", jsonOut, err)
+					}
+				} else {
+					var classed classedError
+					if !errors.As(err, &classed) || classed.class != test.exit {
+						t.Fatalf("json=%t outcome %q mapped to %v, want exit %d", jsonOut, test.outcome, err, test.exit)
+					}
+				}
+				if !jsonOut {
+					if !strings.Contains(stdout.String(), "Performance run: proj/01-alpha\n") || !strings.Contains(stdout.String(), "Outcome: "+string(test.outcome)+"\n") {
+						t.Fatalf("unstable text outcome projection: %q", stdout.String())
+					}
+					continue
+				}
+				var envelope struct {
+					SchemaVersion int                     `json:"schema_version"`
+					Operation     string                  `json:"operation"`
+					Status        string                  `json:"status"`
+					Result        PerformanceStatusResult `json:"result"`
+					Error         json.RawMessage         `json:"error"`
+				}
+				if err := json.Unmarshal(stdout.Bytes(), &envelope); err != nil {
+					t.Fatalf("decode terminal envelope: %v\n%s", err, stdout.String())
+				}
+				if envelope.SchemaVersion != 1 || envelope.Operation != "sprint.performance.run" || envelope.Status != "complete" || envelope.Result.Outcome != string(test.outcome) || len(envelope.Error) != 0 {
+					t.Fatalf("unstable terminal envelope: %+v", envelope)
+				}
+			}
+		})
+	}
+
+	for _, test := range []struct {
+		name string
+		err  error
+		exit int
+	}{
+		{name: "operational failure", err: errors.New("operational failure"), exit: ExitValidation},
+		{name: "operational cancellation", err: context.Canceled, exit: ExitCancel},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			for _, jsonOut := range []bool{false, true} {
+				var stdout, stderr bytes.Buffer
+				status := PerformanceStatusResult{SchemaVersion: 1, Project: "proj", Sprint: "01-alpha", PolicyMode: "enabled", Enabled: true, Phase: "terminal", Fresh: true, NextAction: "retry"}
+				err := writeSprintPerformanceResult(dependencies{stdout: &stdout, stderr: &stderr}, sprintPerformanceCommand{Action: "run", JSON: jsonOut}, "complete", status, test.err)
+				var classed classedError
+				if !errors.As(err, &classed) || classed.class != test.exit {
+					t.Fatalf("json=%t operational error mapped to %v, want exit %d", jsonOut, err, test.exit)
+				}
+				if stderr.String() != "" {
+					t.Fatalf("json=%t wrote stderr %q", jsonOut, stderr.String())
+				}
+				if jsonOut {
+					var envelope struct {
+						SchemaVersion int             `json:"schema_version"`
+						Operation     string          `json:"operation"`
+						Status        string          `json:"status"`
+						Result        json.RawMessage `json:"result"`
+						Error         json.RawMessage `json:"error"`
+					}
+					if decodeErr := json.Unmarshal(stdout.Bytes(), &envelope); decodeErr != nil {
+						t.Fatalf("decode failure envelope: %v\n%s", decodeErr, stdout.String())
+					}
+					if envelope.SchemaVersion != 1 || envelope.Operation != "sprint.performance.run" || envelope.Status != "failed" || len(envelope.Result) == 0 || len(envelope.Error) == 0 {
+						t.Fatalf("unstable failure envelope: %+v", envelope)
+					}
+				} else if !strings.Contains(stdout.String(), "Performance run: proj/01-alpha\n") {
+					t.Fatalf("unstable failure text projection: %q", stdout.String())
+				}
+			}
+		})
 	}
 }
