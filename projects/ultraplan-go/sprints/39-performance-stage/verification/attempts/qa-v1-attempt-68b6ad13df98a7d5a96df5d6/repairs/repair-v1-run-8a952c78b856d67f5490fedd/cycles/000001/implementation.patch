+func renderSprintPerformance(deps dependencies, action string, value any) error {
+	switch result := value.(type) {
+	case PerformancePrepareResult:
+		if _, err := fmt.Fprintf(deps.stdout, "Performance %s: %s/%s\nPolicy: %s\nReady: %t\nTargets: %d\nNext: %s\n", action, result.Project, result.Sprint, result.PolicyMode, result.Ready, len(result.Targets), result.NextAction); err != nil {
+			return err
+		}
+		for _, missing := range result.Missing {
+			if _, err := fmt.Fprintf(deps.stdout, "- missing: %s\n", missing); err != nil {
+				return err
+			}
+		}
+	case PerformanceStatusResult:
+		if _, err := fmt.Fprintf(deps.stdout, "Performance %s: %s/%s\nPolicy: %s\nPhase: %s\nFresh: %t\nOutcome: %s\nTargets: %d\nNext: %s\n", action, result.Project, result.Sprint, result.PolicyMode, result.Phase, result.Fresh, operationFirstNonEmpty(result.Outcome, "none"), len(result.Targets), result.NextAction); err != nil {
+			return err
+		}
+		for _, target := range result.Targets {
+			if _, err := fmt.Fprintf(deps.stdout, "- %s: %s %s %s %s (%s, %s) outcome=%s\n", target.ID, target.Metric, target.Comparator, target.Value, target.Unit, target.Gate, target.Basis, operationFirstNonEmpty(target.Outcome, "pending")); err != nil {
+				return err
+			}
+		}
+	default:
+		_, err := fmt.Fprintf(deps.stdout, "Performance %s\n", action)
+		return err
+	}
+	return nil
 }
 
