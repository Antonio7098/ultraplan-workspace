+			return write("blocked", performancePrepareProjection(prepared), fmt.Errorf("performance admission blocked: %s", strings.Join(prepared.Missing, "; ")))
+		}
+		durable, durableErr := beginDurableCLICommand(deps, OperationRequest{Kind: OperationPerformanceStart, Project: projectRef, Sprint: sprintRef})
+		if durableErr != nil {
+			return write("failed", PerformanceStatusResult{}, durableErr)
+		}
+		token, fence, ownershipErr := durable.VerificationWriterToken()
+		if ownershipErr != nil {
+			return write("failed", PerformanceStatusResult{}, finishDurableCLICommand(durable, ownershipErr))
+		}
+		runtimeService, runtimeErr := sprintRuntimeService(deps, root)
+		if runtimeErr != nil {
+			return write("failed", PerformanceStatusResult{}, finishDurableCLICommand(durable, runtimeErr))
+		}
+		owned := runtimeService.WithVerificationWriterFence(fence)
+		acceptedAt := time.Now().UTC()
+		prepared, prepareErr = owned.PreparePerformance(projectRef, sprintRef, false)
+		if prepareErr != nil {
+			return write("failed", performancePrepareProjection(prepared), finishDurableCLICommand(durable, prepareErr))
+		}
+		manifest, authoringAttempts, manifestErr := owned.PreparePerformanceManifest(durable.Context(), projectRef, sprintRef, prepared, environmentList(deps.env), acceptedAt, token)
+		if manifestErr != nil {
+			return write("failed", performancePrepareProjection(prepared), finishDurableCLICommand(durable, manifestErr))
+		}
+		result, runErr := owned.RunPerformance(durable.Context(), projectRef, sprintRef, sprint.PerformanceRunRequest{WriterToken: token, Manifest: manifest, Environment: environmentList(deps.env), AuthoringAttempts: authoringAttempts, AcceptedAt: acceptedAt})
+		runErr = finishDurableCLICommand(durable, runErr)
+		status, statusErr := performanceStatusProjection(service, projectRef, sprintRef)
+		runErr = errors.Join(runErr, statusErr)
+		if runErr == nil {
+			return finishSprintPerformanceOutcome(deps, command, status, string(result.Outcome))
+		}
+		return write("failed", status, runErr)
+	default:
+		return classified(ExitUsage, "sprint.performance: unsupported action %q", command.Action)
+	}
+}
+
+func writeSprintPerformanceResult(deps dependencies, command sprintPerformanceCommand, status string, value any, runErr error) error {
+	runErr = sprint.ClassifyPerformanceError("performance."+command.Action, runErr)
+	if runErr != nil {
+		status = "failed"
+	}
+	var writeErr error
+	if command.JSON {
+		payload := map[string]any{"schema_version": 1, "operation": "sprint.performance." + command.Action, "status": status, "result": value}
+		if runErr != nil {
+			performanceErr, _ := sprint.AsPerformanceError(runErr)
+			payload["error"] = map[string]string{"code": performanceErr.Code, "message": displaySafe(runErr.Error()), "recovery": performanceErr.Guidance}
+		}
+		writeErr = json.NewEncoder(deps.stdout).Encode(payload)
+	} else {
+		writeErr = renderSprintPerformance(deps, command.Action, value)
+	}
+	runErr = errors.Join(runErr, writeErr)
+	if runErr != nil {
+		if errors.Is(runErr, context.Canceled) {
+			return classified(ExitCancel, "sprint.performance: %w", runErr)
+		}
+		return classified(ExitValidation, "sprint.performance: %w", runErr)
+	}
+	return nil
+}
+
+func finishSprintPerformanceOutcome(deps dependencies, command sprintPerformanceCommand, status PerformanceStatusResult, outcome string) error {
+	return errors.Join(performanceSemanticOutcomeError(outcome), writeSprintPerformanceResult(deps, command, "complete", status, nil))
+}
+
+func performanceSemanticOutcomeError(outcome string) error {
+	switch outcome {
+	case string(sprint.PerformancePassed), string(sprint.PerformancePassedWithReports):
+		return nil
+	case string(sprint.PerformanceTargetMiss):
+		return classified(ExitValidation, "sprint.performance: required target missed")
+	case string(sprint.PerformanceCancelled):
+		return classified(ExitCancel, "sprint.performance: cancelled")
+	default:
+		return classified(ExitPartial, "sprint.performance: outcome %s", outcome)
 	}
 }
