+func TestPerformanceCLITextAndOutcomeExitCompatibility(t *testing.T) {
+	for _, test := range []struct {
+		outcome string
+		exit    int
+	}{
+		{outcome: string(sprint.PerformancePassed), exit: ExitOK},
+		{outcome: string(sprint.PerformancePassedWithReports), exit: ExitOK},
+		{outcome: string(sprint.PerformanceTargetMiss), exit: ExitValidation},
+		{outcome: string(sprint.PerformanceCancelled), exit: ExitCancel},
+		{outcome: string(sprint.PerformanceBlocked), exit: ExitPartial},
+		{outcome: string(sprint.PerformanceStalled), exit: ExitPartial},
+	} {
+		status := PerformanceStatusResult{SchemaVersion: 1, Project: "proj", Sprint: "01-alpha", PolicyMode: "enabled", Enabled: true, Phase: "terminal", Fresh: true, Outcome: test.outcome, NextAction: "inspect"}
+		var jsonStdout, jsonStderr bytes.Buffer
+		err := finishSprintPerformanceOutcome(dependencies{stdout: &jsonStdout, stderr: &jsonStderr}, sprintPerformanceCommand{Action: "run", JSON: true}, status, test.outcome)
+		if test.exit == ExitOK {
+			if err != nil {
+				t.Fatalf("outcome %s err=%v", test.outcome, err)
+			}
+		} else {
+			var classed classedError
+			if !errors.As(err, &classed) || classed.class != test.exit {
+				t.Fatalf("outcome %s err=%v exit=%d", test.outcome, err, classed.class)
+			}
+		}
+		if jsonStderr.String() != "" || !strings.Contains(jsonStdout.String(), `"operation":"sprint.performance.run"`) || !strings.Contains(jsonStdout.String(), `"status":"complete"`) || !strings.Contains(jsonStdout.String(), `"outcome":"`+test.outcome+`"`) {
+			t.Fatalf("JSON outcome %s stdout=%q stderr=%q", test.outcome, jsonStdout.String(), jsonStderr.String())
+		}
+
+		var textStdout, textStderr bytes.Buffer
+		textErr := finishSprintPerformanceOutcome(dependencies{stdout: &textStdout, stderr: &textStderr}, sprintPerformanceCommand{Action: "run"}, status, test.outcome)
+		if (err == nil) != (textErr == nil) || textStderr.String() != "" || !strings.Contains(textStdout.String(), "Outcome: "+test.outcome+"\n") {
+			t.Fatalf("text outcome %s err=%v stdout=%q stderr=%q", test.outcome, textErr, textStdout.String(), textStderr.String())
 		}
 	}
 }
