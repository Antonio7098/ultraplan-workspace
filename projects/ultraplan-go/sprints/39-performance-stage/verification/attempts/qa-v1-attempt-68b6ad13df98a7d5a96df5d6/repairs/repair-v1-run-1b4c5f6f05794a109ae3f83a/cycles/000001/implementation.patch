+func TestSprintPerformanceSemanticOutcomeExitCompatibility(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		outcome sprint.PerformanceRunOutcome
+		exit    int
+	}{
+		{name: "success", outcome: sprint.PerformancePassed, exit: ExitOK},
+		{name: "success with reports", outcome: sprint.PerformancePassedWithReports, exit: ExitOK},
+		{name: "target missed", outcome: sprint.PerformanceTargetMiss, exit: ExitValidation},
+		{name: "cancelled", outcome: sprint.PerformanceCancelled, exit: ExitCancel},
+		{name: "blocked partial", outcome: sprint.PerformanceBlocked, exit: ExitPartial},
+		{name: "stalled partial", outcome: sprint.PerformanceStalled, exit: ExitPartial},
+		{name: "cleanup partial", outcome: sprint.PerformanceCleanupUncertain, exit: ExitPartial},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			err := performanceSemanticOutcomeError(test.outcome)
+			if test.exit == ExitOK {
+				if err != nil {
+					t.Fatalf("successful outcome returned %v", err)
+				}
+				return
+			}
+			var classed classedError
+			if !errors.As(err, &classed) || classed.class != test.exit {
+				t.Fatalf("outcome %q error=%v class=%d, want %d", test.outcome, err, classed.class, test.exit)
+			}
+		})
+	}
+
+	// An operational failure is distinct from a truthful non-success outcome.
+	operational := sprint.ClassifyPerformanceError("performance.run", errors.New("operational failure"))
+	var classed classedError
+	if err := mapPerformanceCommandError(operational); !errors.As(err, &classed) || classed.class != ExitValidation {
+		t.Fatalf("operational failure class=%d error=%v", classed.class, err)
+	}
+	classed = classedError{}
+	if err := mapPerformanceCommandError(context.Canceled); !errors.As(err, &classed) || classed.class != ExitCancel {
+		t.Fatalf("operational cancellation class=%d error=%v", classed.class, err)
 	}
 }
