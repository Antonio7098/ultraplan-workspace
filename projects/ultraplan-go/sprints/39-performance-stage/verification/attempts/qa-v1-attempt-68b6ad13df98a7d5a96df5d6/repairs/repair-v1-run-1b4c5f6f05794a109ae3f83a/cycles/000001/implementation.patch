+func performanceSemanticOutcomeError(outcome sprint.PerformanceRunOutcome) error {
+	switch outcome {
+	case sprint.PerformancePassed, sprint.PerformancePassedWithReports:
+		return nil
+	case sprint.PerformanceTargetMiss:
+		return classified(ExitValidation, "sprint.performance: required target missed")
+	case sprint.PerformanceCancelled:
+		return classified(ExitCancel, "sprint.performance: cancelled")
+	default:
+		return classified(ExitPartial, "sprint.performance: outcome %s", outcome)
+	}
+}
+
+func mapPerformanceCommandError(err error) error {
+	if err == nil {
+		return nil
+	}
+	if errors.Is(err, context.Canceled) {
+		return classified(ExitCancel, "sprint.performance: %w", err)
+	}
+	return classified(ExitValidation, "sprint.performance: %w", err)
 }
 
 func renderSprintPerformance(deps dependencies, action string, value any) error {
