+func TestSprintPerformanceReadOnlyCLICompatibility(t *testing.T) {
+	rootPath := t.TempDir()
+	writeCommandSprintProject(t, rootPath, "proj", "01-alpha")
+	base := filepath.Join(rootPath, "projects", "proj")
+	writeFixtureFileContent(t, base, commandProjectIndex(t), "project-index.md")
+	writeFixtureFileContent(t, base, commandValidRequirements(), "sprints", "01-alpha", "requirements.md")
+	writeFixtureFileContent(t, base, commandValidSprintIndex(), "sprints", "01-alpha", "sprint-index.md")
+	root := workspace.Root{Path: rootPath}
+	service := sprint.NewService(rootPath)
+
+	run := func(args ...string) (string, string, error) {
+		var stdout, stderr bytes.Buffer
+		err := runSprintPerformance(dependencies{
+			stdout: &stdout, stderr: &stderr, ctx: context.Background(), workDir: rootPath, env: map[string]string{},
+		}, root, service, "proj", "01-alpha", args)
+		return stdout.String(), stderr.String(), err
+	}
+
+	for _, test := range []struct {
+		name      string
+		args      []string
+		operation string
+	}{
+		{name: "dry-run", args: []string{"--dry-run", "--json"}, operation: "sprint.performance.dry-run"},
+		{name: "status", args: []string{"status", "--json"}, operation: "sprint.performance.status"},
+	} {
+		t.Run(test.name+" JSON", func(t *testing.T) {
+			stdout, stderr, err := run(test.args...)
+			if err != nil || stderr != "" {
+				t.Fatalf("err=%v stderr=%q stdout=%q", err, stderr, stdout)
+			}
+			var envelope struct {
+				SchemaVersion int                     `json:"schema_version"`
+				Operation     string                  `json:"operation"`
+				Status        string                  `json:"status"`
+				Result        PerformancePrepareResult `json:"result"`
+			}
+			decoder := json.NewDecoder(strings.NewReader(stdout))
+			if err := decoder.Decode(&envelope); err != nil {
+				t.Fatalf("decode envelope: %v\n%s", err, stdout)
+			}
+			var trailing any
+			if err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {
+				t.Fatalf("performance envelope has trailing output: %v\n%s", err, stdout)
+			}
+			if envelope.SchemaVersion != 1 || envelope.Operation != test.operation || envelope.Status != "ok" || envelope.Result.SchemaVersion != 1 || envelope.Result.Project != "proj" || envelope.Result.Sprint != "01-alpha" {
+				t.Fatalf("unstable performance envelope: %+v", envelope)
+			}
+			for _, forbidden := range []string{"raw_samples", "command_output", "profile", "provider_payload", "environment_values"} {
+				if strings.Contains(stdout, forbidden) {
+					t.Fatalf("performance envelope leaked %q: %s", forbidden, stdout)
+				}
+			}
+		})
+	}
+
+	stdout, stderr, err := run("--dry-run")
+	if err != nil || stderr != "" || !strings.Contains(stdout, "Performance dry-run: proj/01-alpha\nPolicy: disabled\n") {
+		t.Fatalf("text compatibility err=%v stdout=%q stderr=%q", err, stdout, stderr)
+	}
+}
