  "theories": [
    {
      "schema_version": 1,
      "id": "qa-v1-theory-f1929f318a162a99b30f7803",
      "shard_id": "qa-v1-shard-b5cbffe80bbe81a8ed6c15f5",
      "claim": "The performance configuration documentation presents hard maxima above several built-in defaults even though the loader rejects every workspace or environment value above the corresponding default, making the documented effective range contradictory and misleading.",
      "basis": "The documentation says workspace and environment values may only lower built-in defaults, but its table lists higher hard maxima such as 4 authoring attempts versus default 2 and 256 commands versus default 128 (qa-v1-block-9a637580a721b349e21044c1). Validation uses each built-in default as the effective ceiling for integer, byte, float, and duration settings (qa-v1-block-a42ba81ee3aabfa3bef7fe97). Safe and obvious defaults and inspectable effective configuration are required by the configuration contract (qa-v1-block-76be07ab5d25adb0b9e502d6).",
      "verification_surface": "Compare every default and hard-maximum row in docs/configuration.md with DefaultPerformance and validatePerformance in internal/platform/config/performance.go.",
      "expectation_refs": [
        "contract-configuration",
        "contract-errors",
        "contract-performance"
      ],
      "severity_if_confirmed": "medium",
      "confirmation_condition": "Confirmed if a documented hard-maximum value above its listed default is rejected by validatePerformance solely because it exceeds the built-in default.",
      "refutation_condition": "Refuted if the documentation explicitly defines hard maximum as a non-configurable internal bound, or validation permits documented values above defaults through a governed source not shown in the cited implementation.",
      "inconclusive_condition": "Inconclusive if omitted documentation or configuration code defines a distinct governed mechanism for selecting values between defaults and hard maxima.",
      "safe_evidence_strategy": "Use static comparison of the frozen documentation table, DefaultPerformance values, and validatePerformance ceilings; no execution or mutation is required.",
      "implementation_fingerprint": "14c7cf690c31fb12f283b6e0f3ae21bc3cfae08b1c430f9deba87cc1c4af79de",
