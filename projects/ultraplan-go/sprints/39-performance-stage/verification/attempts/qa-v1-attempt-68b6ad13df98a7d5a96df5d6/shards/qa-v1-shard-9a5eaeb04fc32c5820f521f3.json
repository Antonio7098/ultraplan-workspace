      "expectation_refs": [
        "contract-performance",
        "contract-security",
        "contract-testing"
      ],
      "severity_if_confirmed": "high",
      "confirmation_condition": "Parsing `## Performance Policy\\n- **Mode:** ENABLED\\n` returns PerformanceEnabled without an error finding.",
      "refutation_condition": "An additional case-sensitive validation step rejects `ENABLED` before the policy can be consumed.",
      "inconclusive_condition": "The frozen parser excerpt does not represent the effective implementation or another mandatory validation layer rejects case-variant modes.",
      "safe_evidence_strategy": "Inspect or add a deterministic parser test for uppercase and mixed-case mode values without invoking runtime dependencies.",
