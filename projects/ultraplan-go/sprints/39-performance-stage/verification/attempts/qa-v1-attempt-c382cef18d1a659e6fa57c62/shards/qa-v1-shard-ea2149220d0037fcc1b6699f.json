      "expectation_refs": [
        "contract-errors"
      ],
      "severity_if_confirmed": "blocker",
      "confirmation_condition": "sharedOperationRunner receives an Effective configuration for which performanceSettings returns an error but constructs or starts an operation without returning that configuration error.",
      "refutation_condition": "Every caller validates identical effective performance settings before sharedOperationRunner is created, making the discarded error unreachable, or performanceSettings cannot fail for runner inputs.",
      "inconclusive_condition": "Caller-side validation or the complete operation-runner construction path demonstrates an unshown guard whose result prevents entry with invalid performance configuration.",
      "safe_evidence_strategy": "Use bounded source inspection or a product-owned test with an invalid performance duration or limit and verify whether sharedOperationRunner returns a classified configuration failure before side effects.",
