      "shard_id": "qa-v1-shard-f9360cf63cd8c1c3e1a2315c",
      "claim": "The performance CLI collapses every classified non-cancellation performance failure into the validation exit class, so configuration, runtime, timeout, dependency, and persistence failures do not retain appropriate CLI exit behavior.",
      "basis": "The CLI handles context cancellation specially but returns every other classified performance error through ExitValidation [qa-v1-block-a1c54f69a34aba9ad20c1302]. The error contract requires narrow truthful categories and preservation of operational signals at CLI boundaries [qa-v1-block-307234c6bfff53948b392930].",
      "verification_surface": "internal/app/sprint_commands.go error rendering and exit classification in runSprintPerformance",
      "expectation_refs": [
        "contract-errors"
      ],
      "severity_if_confirmed": "high",
      "confirmation_condition": "A classified non-cancellation performance error is unconditionally wrapped with ExitValidation instead of an exit class corresponding to its category.",
      "refutation_condition": "The complete command path or classified function preserves a category-specific non-validation exit class despite the explicit ExitValidation wrapper.",
      "inconclusive_condition": "The omitted classified or ClassifyPerformanceError implementation changes the effective exit class in a way not visible in the cited block.",
      "safe_evidence_strategy": "Statically inspect the CLI classification path and use product-owned tests, if available, to assert exit classes for representative performance configuration, runtime, timeout, and data failures.",
