      "severity_if_confirmed": "high",
      "confirmation_condition": "A valid matching envelope followed by malformed trailing content returns its canonical value without an error.",
      "refutation_condition": "The complete implementation requires the second decode error to be io.EOF, or a product-owned test demonstrates malformed trailing content is rejected.",
      "inconclusive_condition": "The bounded excerpt differs materially from the complete parser implementation or another validated boundary rejects such output before parsing.",
