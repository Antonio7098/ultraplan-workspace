    {
      "schema_version": 1,
      "id": "qa-v1-theory-fee802dd66f95e4d140db4f7",
      "shard_id": "qa-v1-shard-4db85fa581a58a0b5aaad223",
      "claim": "Sprint dashboard composition silently discards performance evidence retrieval failures, causing TUI and web summaries to present an empty evidence result instead of an inspectable evidence-gap or failure state.",
      "basis": "The dashboard populates PerformanceEvidence only when evidenceErr is nil, with no else branch or propagated signal (qa-v1-block-c1bc237cbe63b9df34c97ed7). The error contract requires that no failure disappear (qa-v1-block-307234c6bfff53948b392930). Sprint requirements require consistent evidence-gap presentation and presentation-only differences pointing to the same immutable evidence (qa-v1-block-ce45392d2ebc036986b89d13).",
      "verification_surface": "Exercise dashboardUseCases.SprintSummaries for a sprint with a nonempty performance attempt ID while PerformanceEvidence returns an error, then inspect the returned error and performance evidence projection.",
      "expectation_refs": [
        "contract-errors",
        "contract-observability",
        "contract-performance"
      ],
      "severity_if_confirmed": "high",
      "confirmation_condition": "SprintSummaries returns successfully with an empty PerformanceEvidence result and no evidence-gap, blocker, freshness reason, or propagated error after PerformanceEvidence fails.",
      "refutation_condition": "The complete composition path converts the evidence error into an inspectable evidence-gap or failure projection, or a demonstrated invariant makes PerformanceEvidence infallible after a nonempty attempt ID.",
      "inconclusive_condition": "A focused test cannot induce the evidence-query failure or omitted service behavior proves the call cannot fail in this state.",
      "safe_evidence_strategy": "Use a bounded application-use-case test with fixture-backed state whose status has a performance attempt ID and whose evidence artifact is unavailable or invalid; inspect only returned summary fields and errors.",
      "implementation_fingerprint": "e0ad79dc2984c113cf5ddf2820f7bdf5762a97c4c189c34f23a66783743933f8",
