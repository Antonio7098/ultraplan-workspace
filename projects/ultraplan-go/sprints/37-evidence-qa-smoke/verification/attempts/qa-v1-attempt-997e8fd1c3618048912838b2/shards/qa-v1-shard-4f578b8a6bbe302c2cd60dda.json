      "schema_version": 1,
      "id": "qa-v1-theory-8dd9998339d1da5f515da959",
      "shard_id": "qa-v1-shard-4f578b8a6bbe302c2cd60dda",
      "claim": "QAStore Publish may leave partially written evidence plans/patches when evidence bundle validation fails after incremental writes without atomic rollback of attempt subdirectories",
      "basis": "qa_state.go:651-778 publishEvidence writes plans then patches then records sequentially with immutable checks via writeRecord/writeBytes; top-level Publish only snapshots and restores canonical state/report/flow files via captureQACanonicalFiles/restoreQACanonicalFiles, not per-attempt plan/evidence/patch directories. Early return on malformed evidence after some plans already written leaves orphaned immutable artifacts that later PruneAttempts may retain",
      "verification_surface": "internal/sprint/qa_state.go:457-575 and internal/sprint/qa_state.go:651-733",
      "expectation_refs": [
        "contract-observability",
        "contract-persistence-and-migrations"
      ],
      "severity_if_confirmed": "high",
      "confirmation_condition": "After a failed publishEvidence call due to duplicate evidence ID or patch digest mismatch, filesystem contains QAEvidencePlanRelPath file for the failed attempt that is not cleaned and is subsequently loadable via LoadEvidence",
      "refutation_condition": "All publishEvidence error paths return before any writeRecord call (validation-only) or existing test qa_state_test.go:272-319 shows no plan file after malformed bundle and that canonical rollback preserves prior State/Report digests",
      "inconclusive_condition": "Cannot invoke Publish with synthetic malformed bundle without write permission; read-only inspection sees code structure but cannot confirm filesystem side-effect without mutating temp store",
      "safe_evidence_strategy": "Read-only read of QAStore Publish flow, publishEvidence validation order, and inspection of existing qa_state_test.go:315-319 orphan check without creating files or shell execution",
      "implementation_fingerprint": "d6f8e122b892ad435c8e9910dd389ea444a9d26454a4434be04a188f40afe0f2",
